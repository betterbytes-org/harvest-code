# Copy to secrets.env (gitignored) and fill in values.
# Source from Slurm scripts AFTER common.env.

# Optional: faster/more reliable HF downloads (model is public/MIT, not gated)
export HF_TOKEN="hf_xxxxxxxxxxxxxxxx"

# Required: shared team API key (clients pass Authorization: Bearer <key>)
export VLLM_API_KEY="generate-a-long-random-string-here"

# Optional rate-limit overrides (defaults in common.env)
# export RATE_LIMIT_ENABLED=true
# export RATE_LIMIT_REQUESTS_PER_MINUTE=60
# export RATE_LIMIT_BURST=10
