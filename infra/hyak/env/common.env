# Shared Hyak environment for HARVEST compute jobs.
# Source from Slurm scripts:  source "${HARVEST_INFRA}/env/common.env"

HARVEST_ROOT="/gscratch/harvest/rithvik/harvest"
HARVEST_INFRA="${HARVEST_ROOT}/infra/hyak"
HARVEST_SCRATCH="/gscratch/harvest/rithvik"
HARVEST_ENVS="${HARVEST_SCRATCH}/envs"
HARVEST_MODELS="${HARVEST_SCRATCH}/models"
HARVEST_LOGS="${HARVEST_INFRA}/logs"
HARVEST_STATE="${HARVEST_INFRA}/state"

# Slurm account for the harvest group (never run heavy work on login nodes).
# Hyak maps partition -> account automatically; use gpu-h200-harvest for gpu-h200.
export SLURM_ACCOUNT="${SLURM_ACCOUNT:-gpu-h200-harvest}"
export HYAK_ACCOUNT="${HYAK_ACCOUNT:-$SLURM_ACCOUNT}"
export SALLOC_ACCOUNT="${SALLOC_ACCOUNT:-$SLURM_ACCOUNT}"

# CPU jobs without a harvest compute account run on gpu-h200 nodes (CPU only, no --gres).
export HARVEST_CPU_PARTITION="${HARVEST_CPU_PARTITION:-gpu-h200}"
export HARVEST_CPU_ACCOUNT="${HARVEST_CPU_ACCOUNT:-gpu-h200-harvest}"
export HARVEST_CPU_CPUS="${HARVEST_CPU_CPUS:-8}"
export HARVEST_CPU_MEM="${HARVEST_CPU_MEM:-16G}"

# GPU partition and allocation for exclusive 2x H200.
export HARVEST_GPU_PARTITION="${HARVEST_GPU_PARTITION:-gpu-h200}"
export HARVEST_GPU_GRES="${HARVEST_GPU_GRES:-gpu:h200:2}"
export HARVEST_GPU_CPUS="${HARVEST_GPU_CPUS:-16}"
export HARVEST_GPU_MEM="${HARVEST_GPU_MEM:-128G}"

# Model + inference server settings.
export HF_HOME="${HF_HOME:-${HARVEST_MODELS}/huggingface}"
export VLLM_MODEL="${VLLM_MODEL:-deepseek-ai/DeepSeek-V4-Flash-0731}"
export VLLM_SERVED_NAME="${VLLM_SERVED_NAME:-deepseek-v4-flash-0731}"
# Auth proxy (public). vLLM uses 8000 for NCCL rendezvous and 8001 for its API.
export VLLM_PROXY_PORT="${HARVEST_VLLM_PROXY_PORT:-18080}"
export VLLM_INTERNAL_PORT="${VLLM_INTERNAL_PORT:-8001}"
export VLLM_TP_SIZE="${VLLM_TP_SIZE:-2}"

# Rate-limit proxy (configurable via secrets.env or rate-limit.env)
export RATE_LIMIT_ENABLED="${RATE_LIMIT_ENABLED:-true}"
export RATE_LIMIT_REQUESTS_PER_MINUTE="${RATE_LIMIT_REQUESTS_PER_MINUTE:-60}"
export RATE_LIMIT_BURST="${RATE_LIMIT_BURST:-10}"
export VLLM_VENV="${VLLM_VENV:-${HARVEST_ENVS}/vllm-dsv4}"

export RUSTUP_HOME="${RUSTUP_HOME:-${HARVEST_ENVS}/rustup}"
export CARGO_HOME="${CARGO_HOME:-${HARVEST_ENVS}/cargo}"
export PATH="${CARGO_HOME}/bin:${PATH}"

mkdir -p "${HF_HOME}" "${HARVEST_LOGS}" "${HARVEST_STATE}" "${HARVEST_ENVS}"

# LiteLLM gateway (replaces stdlib vllm_api_proxy.py when GATEWAY_ENABLED=true)
export GATEWAY_ENABLED="${GATEWAY_ENABLED:-true}"
export LITELLM_PORT="${LITELLM_PORT:-4000}"
export LITELLM_CONFIG="${LITELLM_CONFIG:-${HARVEST_INFRA}/gateway/litellm_config.yaml}"
export HARVEST_PGDATA="${HARVEST_PGDATA:-${HARVEST_SCRATCH}/pgdata/litellm}"
export HARVEST_PGPORT="${HARVEST_PGPORT:-5433}"
export LITELLM_VENV="${LITELLM_VENV:-${HARVEST_ENVS}/litellm}"
export DATABASE_URL="${DATABASE_URL:-postgresql://litellm@127.0.0.1:${HARVEST_PGPORT}/litellm}"
